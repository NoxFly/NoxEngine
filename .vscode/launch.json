{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NoxEngine Sandbox (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Debug/NoxEngineSandbox.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/sandbox",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake Build (Debug)",
            "logging": {
                "moduleLoad": false
            }
        },
        {
            "name": "NoxEngine Sandbox (GDB / Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/NoxEngineSandbox",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/sandbox",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake Build (Debug)",
            "logging": {
                "moduleLoad": false
            }
        }
    ]
}
